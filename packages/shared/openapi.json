{
  "openapi": "3.0.0",
  "info": {
    "title": "AICTE Approval Control Tower API",
    "description": "Automated AICTE approval workflow, compliance monitoring and dual-clock SLA engine API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "summary": "User authentication and JWT token issuance",
        "tags": ["Authentication"],
        "responses": {
          "200": { "description": "Login successful" },
          "401": { "description": "Invalid credentials or TOTP" }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "Refresh token rotation with reuse detection",
        "tags": ["Authentication"],
        "responses": {
          "200": { "description": "Token refreshed" },
          "401": { "description": "Invalid or revoked token" }
        }
      }
    },
    "/api/v1/applications": {
      "get": {
        "summary": "List applications with filtering and pagination",
        "tags": ["Applications"],
        "responses": {
          "200": { "description": "List of applications" }
        }
      },
      "post": {
        "summary": "Create draft application",
        "tags": ["Applications"],
        "responses": {
          "201": { "description": "Draft created" }
        }
      }
    },
    "/api/v1/applications/{id}/submit": {
      "post": {
        "summary": "Submit application with 3-layer validation check",
        "tags": ["Applications"],
        "responses": {
          "200": { "description": "Application submitted" },
          "422": { "description": "Validation failures" }
        }
      }
    },
    "/api/v1/applications/{id}/transition": {
      "post": {
        "summary": "State machine transition in single DB transaction",
        "tags": ["Workflow"],
        "responses": {
          "200": { "description": "Transition succeeded" },
          "409": { "description": "Version conflict" }
        }
      }
    },
    "/api/v1/applications/{id}/clocks": {
      "get": {
        "summary": "Get dual-clock status and SLA duration",
        "tags": ["Dual clocks"],
        "responses": {
          "200": { "description": "Clock summary" }
        }
      }
    },
    "/api/v1/tasks/my": {
      "get": {
        "summary": "Get tasks assigned to current user",
        "tags": ["Tasks & Workload"],
        "responses": {
          "200": { "description": "My tasks" }
        }
      }
    },
    "/api/v1/compliance/radar": {
      "get": {
        "summary": "Query expiring compliance records",
        "tags": ["Compliance radar"],
        "responses": {
          "200": { "description": "Expiring compliance records" }
        }
      }
    },
    "/api/v1/audit/verify": {
      "get": {
        "summary": "Verify append-only hash-chained audit ledger",
        "tags": ["Audit ledger"],
        "responses": {
          "200": { "description": "Verification result" }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Liveness probe",
        "tags": ["Observability & Health"],
        "responses": {
          "200": { "description": "Healthy" }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readiness probe",
        "tags": ["Observability & Health"],
        "responses": {
          "200": { "description": "Ready" }
        }
      }
    }
  }
}
