# Environment Configuration for AICTE Approval Control Tower
NODE_ENV=development

# Database (PostgreSQL 16 with pgvector & pgcrypto)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aicte_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aicte_db
POSTGRES_PORT=5432

# Redis 7 (Queues & BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO S3 Storage
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_DOCUMENTS=aicte-documents
S3_BUCKET_REPORTS=aicte-reports
S3_REGION=us-east-1

# API Service
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Auth & Security
JWT_ACCESS_SECRET=aicte-access-secret-minimum-32-characters-change-in-production-12345
JWT_REFRESH_SECRET=aicte-refresh-secret-minimum-32-characters-change-in-production-67890
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
TOTP_ISSUER="AICTE Approval Tower"

# Web Client (Next.js)
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SSE_URL=http://localhost:4000/api/v1/realtime/sse
NEXT_PUBLIC_APP_NAME="AICTE Approval Control Tower"

# AI Service (FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_PORT=8000
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_PROVIDER=claude

# Observability
LOG_LEVEL=debug
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
SENTRY_DSN=
